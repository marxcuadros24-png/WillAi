# Django
SECRET_KEY=django-insecure-willai-dev-secret-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,192.168.1.7,*

# Database (PostgreSQL / PostGIS)
DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_NAME=alerta_incendios_coracora
